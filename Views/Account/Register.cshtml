@model _25dh110213_LTW.Models.ViewModel.RegisterVM

@{
    ViewBag.Title = "Đăng ký tài khoản";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container" style="max-width: 600px; background: #fff; padding: 25px; border-radius: 6px; margin-top: 30px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    <h2 style="text-align: center; margin-bottom: 20px;">ĐĂNG KÝ TÀI KHOẢN KHÁCH HÀNG</h2>
    <hr />

    @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()

        <div class="text-danger" style="margin-bottom: 15px;">
            @Html.ValidationSummary(true)
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            @Html.LabelFor(m => m.Username, new { @class = "control-label" })
            @Html.TextBoxFor(m => m.Username, new { @class = "form-control", placeholder = "Nhập tên đăng nhập..." })
            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            @Html.LabelFor(m => m.Password, new { @class = "control-label" })
            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Nhập mật khẩu..." })
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            @Html.LabelFor(m => m.ConfirmPassword, new { @class = "control-label" })
            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Xác nhận lại mật khẩu..." })
            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            @Html.LabelFor(m => m.CustomerName, new { @class = "control-label" })
            @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control", placeholder = "Nhập họ và tên..." })
            @Html.ValidationMessageFor(m => m.CustomerName, "", new { @class = "text-danger" })
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            @Html.LabelFor(m => m.CustomerPhone, new { @class = "control-label" })
            @Html.TextBoxFor(m => m.CustomerPhone, new { @class = "form-control", placeholder = "Nhập số điện thoại..." })
            @Html.ValidationMessageFor(m => m.CustomerPhone, "", new { @class = "text-danger" })
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            @Html.LabelFor(m => m.CustomerEmail, new { @class = "control-label" })
            @Html.TextBoxFor(m => m.CustomerEmail, new { @class = "form-control", type = "email", placeholder = "Nhập email..." })
            @Html.ValidationMessageFor(m => m.CustomerEmail, "", new { @class = "text-danger" })
        </div>

        <div class="form-group" style="margin-bottom: 20px;">
            @Html.LabelFor(m => m.CustomerAddress, new { @class = "control-label" })
            @Html.TextBoxFor(m => m.CustomerAddress, new { @class = "form-control", placeholder = "Nhập địa chỉ..." })
            @Html.ValidationMessageFor(m => m.CustomerAddress, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-primary" style="width: 100%; background-color: #ffd814; color: #000; font-weight: bold; border: 1px solid #fcd200; padding: 10px;">
                Đăng ký
            </button>
        </div>

        <div style="text-align: center; margin-top: 15px;">
            <p>Bạn đã có tài khoản? <a href="@Url.Action("Login", "Account")">Đăng nhập</a></p>
        </div>
    }
</div>