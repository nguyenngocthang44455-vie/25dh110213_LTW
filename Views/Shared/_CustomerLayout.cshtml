@{
    // 1. Lấy giỏ hàng an toàn từ Session
    var cartService = new _25dh110213_LTW.Models.ViewModel.CartService(Session);
    var cart = cartService.GetCart();

    // 2. Tính tổng số lượng sản phẩm trong giỏ (Tránh lỗi NullReference)
    int itemCount = 0;
    if (cart != null && cart.Items != null)
    {
        itemCount = cart.Items.Sum(i => i.Quantity);
    }

    // 3. Tạo Model chứa dữ liệu hiển thị menu cá nhân
    var customerName = Session["CustomerName"] as string;
    var pmModel = new _25dh110213_LTW.Models.ViewModel.PersonalMenuVM
    {
        IsLoggedIn = !string.IsNullOrEmpty(customerName) || Request.IsAuthenticated,
        Username = !string.IsNullOrEmpty(customerName) ? customerName : (Request.IsAuthenticated ? User.Identity.Name : ""),
        CartCount = itemCount
    };
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - My Store</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <link href="~/Content/PagedList.css" rel="stylesheet" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background-color: #eaeded;
            color: #0f1111;
        }

        .amazon-header {
            background-color: #131921;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 15px;
            gap: 15px;
        }

        .logo-amazon {
            font-size: 22px;
            font-weight: bold;
            color: #ff9900;
            text-decoration: none;
            letter-spacing: 1px;
        }

        .search-section {
            flex: 1;
            max-width: 800px;
        }

        .search-container {
            display: flex;
            width: 100%;
        }

        #search-input {
            width: 100%;
            padding: 9px 12px;
            border: none;
            border-radius: 4px 0 0 4px;
            outline: none;
            font-size: 14px;
        }

        #search-button {
            padding: 9px 18px;
            background-color: #febd69;
            color: #111;
            border: none;
            border-radius: 0 4px 4px 0;
            cursor: pointer;
            font-size: 15px;
        }

            #search-button:hover {
                background-color: #f3a847;
            }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 20px;
            font-size: 13px;
        }

            .header-actions a {
                color: #ffffff;
                text-decoration: none;
            }

        .cart {
            position: relative;
            display: flex;
            align-items: center;
        }

        .fa-shopping-cart {
            font-size: 22px;
        }

        .cart-count {
            position: absolute;
            top: -6px;
            right: -8px;
            background-color: #f08804;
            color: #111;
            font-size: 11px;
            padding: 1px 5px;
            border-radius: 50%;
            font-weight: bold;
        }

        .main-menu {
            background-color: #232f3e;
            padding: 8px 15px;
        }

            .main-menu ul {
                list-style: none;
                display: flex;
                gap: 18px;
                align-items: center;
                flex-wrap: wrap;
            }

                .main-menu ul li a {
                    color: #ffffff;
                    text-decoration: none;
                    font-size: 13px;
                    font-weight: 500;
                }

        .container {
            max-width: 1400px;
            margin: 20px auto;
            padding: 0 20px 30px;
            position: relative;
            z-index: 2;
        }

        footer {
            background-color: #131921;
            padding: 20px;
            text-align: center;
            font-size: 12px;
            color: #ddd;
            margin-top: 40px;
        }
        .user-menu {
            position: relative;
        }

            .user-menu > a {
                cursor: pointer;
            }

            .user-menu .user-dropdown {
                display: none;
                position: absolute;
                right: 0;
                top: 100%;
                min-width: 190px;
                background: #fff;
                border: 1px solid #ddd;
                z-index: 1000;
                padding: 5px 0;
            }

            .user-menu:hover .user-dropdown {
                display: block;
            }

            .user-menu .user-dropdown a {
                display: block;
                color: #111 !important;
                padding: 8px 15px;
                white-space: nowrap;
            }

                .user-menu .user-dropdown a:hover {
                    background: #f3f3f3;
                }

            .user-menu .user-dropdown hr {
                margin: 4px 0;
                border: 0;
                border-top: 1px solid #eee;
            }
    </style>
    @RenderSection("styles", required: false)
</head>
<body>
    <header class="amazon-header">
        @Html.ActionLink("My Store", "Index", "Home", new { area = "" }, new { @class = "logo-amazon" })
        <section class="search-section">
            @using (Html.BeginForm("Index", "Home", new { area = "" }, FormMethod.Get, new { @class = "search-container" }))
            {
                <input type="text" id="search-input" name="searchString" placeholder="Nhập từ khóa tìm kiếm..." />
                <button type="submit" id="search-button"><i class="fas fa-search"></i></button>
            }
        </section>

        <div class="header-actions">
            <div class="user-menu">
                <a href="#">
                    <i class="fas fa-user"></i>
                    @if (pmModel.IsLoggedIn)
                    {
                        <span>Xin chào, <strong>@pmModel.Username</strong></span>
                    }
                    else
                    {
                        <span>Tài khoản</span>
                    }
                    <i class="fas fa-caret-down"></i>
                </a>
                <div class="user-dropdown">
                    @* ... giữ nguyên phần trên ... *@
                    @if (pmModel.IsLoggedIn)
                    {
                        @Html.ActionLink("Thông tin tài khoản", "ProfileInfo", "Account", new { area = "" }, null)
                        @Html.ActionLink("Lịch sử mua hàng", "MyOrder", "Order", new { area = "" }, null)
                        <hr />
                        @Html.ActionLink("Đăng xuất", "Logout", "Account", new { area = "" }, null)
                    }
                    @* ... phần còn lại giữ nguyên ... *@
                    else
                    {
                        @Html.ActionLink("Đăng ký", "Register", "Account", new { area = "" }, null)
                        @Html.ActionLink("Đăng nhập", "Login", "Account", new { area = "" }, null)
                    }
                </div>
            </div>
            <div class="cart">
                <a href="@Url.Action("Index", "Cart", new { area = "" })">
                    <i class="fas fa-shopping-cart"></i>
                    <span class="cart-count">@pmModel.CartCount</span>
                </a>
            </div>
        </div>
    </header>

    <nav class="main-menu">
        <ul>
            <li><a href="@Url.Action("Index", "Home", new { area = "" })"><i class="fas fa-bars"></i> All</a></li>
            <li><a href="@Url.Action("Index", "Home", new { area = "" })">TRANG CHỦ</a></li>
            <!-- Gọi Partial View danh mục sản phẩm từ Database -->
            @Html.Action("CategoriesPV", "Home", new { area = "" })
        </ul>
    </nav>

    <main class="container">
        @RenderBody()
    </main>

    <footer>
        <p>&copy; @DateTime.Now.Year - My Store. All rights reserved.</p>
        <p>Thành viên nhóm: Tên các thành viên trong nhóm</p>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>