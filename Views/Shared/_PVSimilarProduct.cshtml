@model PagedList.IPagedList<_25dh110213_LTW.Models.Product>
@using PagedList.Mvc

<div class="similar-products" style="margin-top:20px;">
    <div style="display:flex; gap:12px; flex-wrap:wrap;">
        @foreach (var item in Model)
        {
            <div style="width:180px; border:1px solid #eee; padding:8px; text-align:center; border-radius:4px;">
                <a href="@Url.Action("ProductDetails", "Home", new { id = item.ProductID })" style="text-decoration:none; color:#111;">
                    <img src="@Url.Content(item.ProductImage ?? "~/Content/images/default_img.png")" style="width:100%; height:110px; object-fit:cover;" alt="@item.ProductName" />
                    <div style="font-size:13px; margin-top:8px;">@item.ProductName</div>
                    <div style="color:#b12704; font-weight:bold;">@item.ProductPrice.ToString("N0") đ</div>
                </a>
            </div>
        }
    </div>

    <div class="text-center" style="margin-top:12px;">
        @{
            var currentAction = ViewContext.RouteData.Values["action"] as string;
            var currentController = ViewContext.RouteData.Values["controller"] as string;
        }
        @Html.PagedListPager(Model, page => Url.Action(currentAction, currentController, new { page }))
    </div>
</div>