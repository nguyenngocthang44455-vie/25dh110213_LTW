@using PagedList
@using PagedList.Mvc
@model IPagedList<_25dh110213_LTW.Models.Product>

@{
    ViewBag.Title = "Danh sách sản phẩm";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    string categoryName = ViewBag.CategoryName;
    int? categoryId = ViewBag.CategoryID;
    string sortOrder = ViewBag.SortOrder;
}

<h3 class="section-title">@categoryName</h3>

<form method="get" action="@Url.Action("ProductList", "Home", new { area = "" })" class="form-inline" style="margin-bottom:15px;">
    @if (categoryId.HasValue)
    {
        <input type="hidden" name="id" value="@categoryId" />
    }
    <select name="sortOrder" class="form-control">
        <option value="">Mới nhất</option>
        <option value="name_asc" @(sortOrder == "name_asc" ? "selected" : "")>Tên: A → Z</option>
        <option value="price_asc" @(sortOrder == "price_asc" ? "selected" : "")>Giá: thấp → cao</option>
        <option value="price_desc" @(sortOrder == "price_desc" ? "selected" : "")>Giá: cao → thấp</option>
    </select>
    <input type="submit" value="Sắp xếp" class="btn btn-primary" />
</form>

@if (Model.TotalItemCount == 0)
{
    <p class="text-muted">Danh mục này chưa có sản phẩm.</p>
}
else
{
    <div class="row">
        @foreach (var p in Model)
        {
            <div class="col-xs-6 col-sm-4">
                @Html.Partial("_PVProductCard", p)
            </div>
        }
    </div>
    <div class="text-center">
        @Html.PagedListPager(Model,
            page => Url.Action("ProductList", "Home", new { area = "", id = categoryId, sortOrder = sortOrder, page }),
            PagedListRenderOptions.Classic)
    </div>
}
