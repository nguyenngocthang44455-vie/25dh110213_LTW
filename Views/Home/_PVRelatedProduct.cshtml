@model IEnumerable<_25dh110213_LTW.Models.Product>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-3" style="margin-bottom: 15px;">
            <div style="border: 1px solid #e7e7e7; padding: 10px; border-radius: 4px; text-align: center; background: #fff;">
                <img src="@Url.Content(item.ProductImage ?? "~/Content/images/default_img.png")" alt="@item.ProductName" style="width: 100%; height: 130px; object-fit: cover;" />
                <h4 style="font-size: 13px; margin: 8px 0; height: 35px; overflow: hidden; color: #0f1111;">@item.ProductName</h4>
                <p style="color: #b12704; font-weight: bold; font-size: 13px;">@item.ProductPrice.ToString("N0") đ</p>
                @Html.ActionLink("Chi tiết", "ProductDetails", "Home", new { id = item.ProductID }, new { @class = "btn btn-warning btn-xs", @style = "background-color: #ffd814; color: #000; font-weight: bold; font-size: 11px;" })
            </div>
        </div>
    }
</div>