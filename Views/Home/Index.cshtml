@using PagedList.Mvc
@model _25dh110213_LTW.Models.ViewModel.HomeProductVM

@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<!-- Banner quảng cáo -->
<section class="banner" style="background-image: linear-gradient(to bottom, rgba(0,0,0,0.1), #eaeded), url('https://picsum.photos/1200/400'); background-position: center; background-size: cover; background-repeat: no-repeat; height: 300px; display: flex; align-items: center; padding-left: 40px; margin-bottom: 25px;">
    <div class="banner-content" style="background: rgba(255, 255, 255, 0.9); padding: 20px; border-radius: 4px; max-width: 380px;">
        <h2 style="font-size: 22px; margin-bottom: 8px; color: #0f1111;">Chào mừng đến với My Store</h2>
        <p style="font-size: 12px; color: #565959; margin-bottom: 12px;">Mua sắm trực tuyến với hàng ngàn sản phẩm đa dạng và chất lượng.</p>
        <a href="#" class="btn" style="display: inline-block; padding: 8px 14px; background-color: #ffd814; color: #0f1111; text-decoration: none; font-weight: bold; font-size: 12px; border-radius: 15px;">MUA SẮM NGAY &gt;</a>
    </div>
</section>

<!-- Thanh tìm kiếm sản phẩm -->
<section class="search-section" style="text-align: center; margin-bottom: 25px;">
    @using (Html.BeginForm("Index", "Home", FormMethod.Get, new { @class = "search-container", @style = "display: flex; justify-content: center;" }))
    {
        <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Nhập tên, mô tả hoặc loại sản phẩm..." style="width: 450px; padding: 10px; border: 1px solid #ccc; border-radius: 4px 0 0 4px; outline: none;" />
        <button type="submit" style="padding: 10px 20px; background-color: #ffd814; border: 1px solid #fcd200; font-weight: bold; border-radius: 0 4px 4px 0; cursor: pointer;">Tìm kiếm</button>
    }
</section>

<!-- Phần 1: Sản phẩm nổi bật (Featured Products) -->
<section class="product-list" style="background-color: #fff; padding: 15px; border-radius: 4px; margin-bottom: 25px;">
    <h2 style="font-size: 18px; margin-bottom: 12px; color: #0f1111; border-bottom: 2px solid #ffd814; padding-bottom: 5px;">SẢN PHẨM NỔI BẬT</h2>

    <ul class="list-container" style="list-style: none; display: grid; grid-template-columns: repeat(5, 1fr); gap: 15px; padding: 0;">
        @if (Model.FeaturedProducts != null && Model.FeaturedProducts.Any())
        {
            foreach (var item in Model.FeaturedProducts)
            {
                <li class="product-item" style="border: 1px solid #e7e7e7; padding: 10px; background: #fff; border-radius: 4px; display: flex; flex-direction: column; justify-content: space-between;">
                    <div class="img-box" style="position: relative;">
                        <img src="@Url.Content(item.ProductImage ?? "~/Content/images/default_img.png")" alt="@item.ProductName" style="width: 100%; height: 150px; object-fit: cover;" />
                    </div>
                    <h3 style="font-size: 13px; margin: 8px 0 4px; font-weight: normal; height: 36px; overflow: hidden; color: #0f1111;">@item.ProductName</h3>
                    <p class="price" style="font-weight: bold; font-size: 14px; color: #b12704;">@string.Format("{0:N0}", item.ProductPrice) đ</p>
                    <div style="margin-top: 10px; display: flex; gap: 5px;">
                        @Html.ActionLink("Chi tiết", "ProductDetails", "Home", new { id = item.ProductID }, new { @class = "btn btn-info btn-xs", @style = "padding: 5px 8px; background-color: #febd69; color: #111; text-decoration: none; border-radius: 3px; font-size: 11px;" })
                        @Html.ActionLink("Thêm giỏ", "AddToCart", "Cart", new { id = item.ProductID }, new { @class = "btn btn-warning btn-xs", @style = "padding: 5px 8px; background-color: #ffd814; color: #111; text-decoration: none; border-radius: 3px; font-size: 11px;" })
                    </div>
                </li>
            }
        }
    </ul>
</section>

<!-- Phần 2: Danh sách sản phẩm mới (New Products kèm phân trang) -->
<section class="product-list" style="background-color: #fff; padding: 15px; border-radius: 4px;">
    <h2 style="font-size: 18px; margin-bottom: 12px; color: #0f1111; border-bottom: 2px solid #ffd814; padding-bottom: 5px;">DANH SÁCH SẢN PHẨM MỚI</h2>

    <ul class="list-container" style="list-style: none; display: grid; grid-template-columns: repeat(5, 1fr); gap: 15px; padding: 0;">
        @if (Model.NewProducts != null && Model.NewProducts.Any())
        {
            foreach (var item in Model.NewProducts)
            {
                <li class="product-item" style="border: 1px solid #e7e7e7; padding: 10px; background: #fff; border-radius: 4px; display: flex; flex-direction: column; justify-content: space-between;">
                    <div class="img-box" style="position: relative;">
                        <img src="@Url.Content(item.ProductImage ?? "~/Content/images/default_img.png")" alt="@item.ProductName" style="width: 100%; height: 150px; object-fit: cover;" />
                    </div>
                    <h3 style="font-size: 13px; margin: 8px 0 4px; font-weight: normal; height: 36px; overflow: hidden; color: #0f1111;">@item.ProductName</h3>
                    <p class="price" style="font-weight: bold; font-size: 14px; color: #b12704;">@string.Format("{0:N0}", item.ProductPrice) đ</p>
                    <div style="margin-top: 10px; display: flex; gap: 5px;">
                        @Html.ActionLink("Chi tiết", "ProductDetails", "Home", new { id = item.ProductID }, new { @class = "btn btn-info btn-xs", @style = "padding: 5px 8px; background-color: #febd69; color: #111; text-decoration: none; border-radius: 3px; font-size: 11px;" })
                        @Html.ActionLink("Thêm giỏ", "AddToCart", "Cart", new { id = item.ProductID }, new { @class = "btn btn-warning btn-xs", @style = "padding: 5px 8px; background-color: #ffd814; color: #111; text-decoration: none; border-radius: 3px; font-size: 11px;" })
                    </div>
                </li>
            }
        }
    </ul>

    <!-- Thanh phân trang PagedList -->
    <div class="text-center" style="margin-top: 20px;">
        @Html.PagedListPager(Model.NewProducts, page => Url.Action("Index", new { page, searchTerm = Model.SearchTerm }))
    </div>
</section>