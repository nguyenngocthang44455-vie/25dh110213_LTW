@model PagedList.IPagedList<_25dh110213_LTW.Models.Product>
@using PagedList.Mvc;
<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4" style="margin-bottom: 20px;">
            <div class="product-item">
                <img src="@Url.Content(item.ProductImage ?? "~/Content/images/default_img.png")" alt="@item.ProductName" class="img-responsive" />
                <h4><a href="@Url.Action("ProductDetails", "Home", new { id = item.ProductID })">@item.ProductName</a></h4>
                <p class="price">@item.ProductPrice.ToString("N0") đ</p>
                <a href="@Url.Action("AddToCart", "Cart", new { id = item.ProductID })" class="btn btn-sm btn-warning" style="font-weight: bold;">Thêm vào giỏ</a>
            </div>
        </div>
    }
</div>

<div class="text-center">
    @Html.PagedListPager(Model, page => Url.Action("Index", "Home", new { page, searchTerm = Request.QueryString["searchTerm"] }))
</div>