@model IEnumerable<_25dh110213_LTW.Models.Product>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-3" style="margin-bottom: 20px;">
            <div class="product-item">
                <img src="~/Content/images/@item.ProductImage" alt="@item.ProductName" class="img-responsive" />
                <h4><a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })">@item.ProductName</a></h4>
                <p class="price">@item.ProductPrice.ToString("N0") đ</p>
                <a href="@Url.Action("AddToCart", "Cart", new { id = item.ProductID })" class="btn btn-sm btn-warning" style="font-weight: bold;">Thêm vào giỏ</a>
            </div>
        </div>
    }
</div>