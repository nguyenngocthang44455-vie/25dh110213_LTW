@model _25dh110213_LTW.Models.User

@{
    ViewBag.Title = "Xóa tài khoản";
}

<h2>XÓA TÀI KHOẢN</h2>

<h3>Bạn có chắc chắn muốn xóa tài khoản này không?</h3>
<div>
    <h4>Thông tin tài khoản</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>Tên đăng nhập</dt>
        <dd>@Model.Username</dd>

        <dt>Vai trò</dt>
        <dd>@(Model.UserRole == "A" ? "Quản trị viên" : Model.UserRole == "S" ? "Nhân viên" : Model.UserRole)</dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Xóa" class="btn btn-danger" />
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
        </div>
    }
</div>
