@using PagedList
@using PagedList.Mvc
@model IPagedList<_25dh110213_LTW.Models.Customer>

@{
    ViewBag.Title = "Danh sách khách hàng";
    string searchTerm = ViewBag.SearchTerm;
    string sortOrder = ViewBag.SortOrder;
}

<h2>DANH SÁCH KHÁCH HÀNG</h2>

@using (Html.BeginForm("Index", "Customers", FormMethod.Get))
{
    <div class="form-inline" style="margin-bottom:15px;">
        <input type="text" name="searchTerm" value="@searchTerm" class="form-control" placeholder="Tên, số điện thoại hoặc email..." style="width:300px;" />
        <select name="sortOrder" class="form-control">
            <option value="">Tên: A → Z</option>
            <option value="name_desc" @(sortOrder == "name_desc" ? "selected" : "")>Tên: Z → A</option>
        </select>
        <input type="submit" value="Tìm kiếm" class="btn btn-primary" />
    </div>
}

<table class="table">
    <tr class="bg-primary">
        <th>Họ và tên</th>
        <th>Số điện thoại</th>
        <th>Email</th>
        <th>Địa chỉ</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.CustomerName</td>
            <td>@item.CustomerPhone</td>
            <td>@item.CustomerEmail</td>
            <td>@item.CustomerAddress</td>
            <td>
                @Html.ActionLink("Chi tiết", "Details", new { id = item.CustomerID }, new { @class = "btn btn-info btn-sm" })
                @Html.ActionLink("Đơn hàng", "Index", "Orders", new { area = "Admin", customerId = item.CustomerID }, new { @class = "btn btn-success btn-sm" })
            </td>
        </tr>
    }
</table>

@if (Model.TotalItemCount == 0)
{
    <p class="text-muted">Chưa có dữ liệu.</p>
}
else
{
    <div>Trang @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) / @Model.PageCount</div>
    @Html.PagedListPager(Model, page => Url.Action("Index", new { page, searchTerm = searchTerm, sortOrder = sortOrder }), PagedListRenderOptions.Classic)
}
