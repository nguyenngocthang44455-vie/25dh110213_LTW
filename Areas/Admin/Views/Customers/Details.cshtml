@model _25dh110213_LTW.Models.Customer

@{
    ViewBag.Title = "Chi tiết khách hàng";
    var orders = (System.Collections.Generic.List<_25dh110213_LTW.Models.Order>)ViewBag.Orders;
}

<h2>CHI TIẾT KHÁCH HÀNG</h2>

<div>
    <h4>Thông tin khách hàng</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>Họ và tên</dt>
        <dd>@Model.CustomerName</dd>

        <dt>Số điện thoại</dt>
        <dd>@Model.CustomerPhone</dd>

        <dt>Email</dt>
        <dd>@Model.CustomerEmail</dd>

        <dt>Địa chỉ</dt>
        <dd>@Model.CustomerAddress</dd>
    </dl>
</div>

<h4>Đơn hàng của khách này (@orders.Count)</h4>
<table class="table">
    <tr class="bg-primary">
        <th>Mã đơn</th>
        <th>Ngày đặt</th>
        <th>Tổng tiền</th>
        <th>Thanh toán</th>
        <th>Địa chỉ giao hàng</th>
        <th></th>
    </tr>
    @foreach (var o in orders)
    {
        <tr>
            <td>#@o.OrderID</td>
            <td>@string.Format("{0:dd/MM/yyyy HH:mm}", o.OrderDate)</td>
            <td>@string.Format("{0:N0}", o.TotalAmount)</td>
            <td>@o.PaymentStatus</td>
            <td>@o.AddressDelivery</td>
            <td>@Html.ActionLink("Chi tiết", "Details", "Orders", new { area = "Admin", id = o.OrderID }, new { @class = "btn btn-info btn-sm" })</td>
        </tr>
    }
</table>

<p>
    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
</p>
