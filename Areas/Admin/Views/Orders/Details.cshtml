@model _25dh110213_LTW.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";
}

<h2>CHI TIẾT ĐƠN HÀNG #@Model.OrderID</h2>
<hr />

<div class="panel panel-primary">
    <div class="panel-heading"><strong>Thông tin đơn hàng</strong></div>
    <div class="panel-body">
        <p><strong>Khách hàng:</strong> @(Model.Customer != null ? Model.Customer.CustomerName : "Khách lẻ")</p>
        <p><strong>Ngày đặt hàng:</strong> @string.Format("{0:dd/MM/yyyy HH:mm}", Model.OrderDate)</p>
        <p><strong>Địa chỉ giao hàng:</strong> @Model.AddressDelivery</p>
        <p><strong>Thanh toán:</strong> @Model.PaymentStatus</p>
        <p><strong>Tổng tiền:</strong> @string.Format("{0:N0}", Model.TotalAmount)</p>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-heading"><strong>Danh sách sản phẩm</strong></div>
    <div class="panel-body">
        <table class="table table-bordered">
            <tr class="bg-primary">
                <th>Tên sản phẩm</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
            @foreach (var item in Model.OrderDetails)
            {
                <tr>
                    <td>@(item.Product != null ? item.Product.ProductName : "")</td>
                    <td>@item.Quantity</td>
                    <td>@string.Format("{0:N0}", item.UnitPrice)</td>
                    <td>@string.Format("{0:N0}", item.UnitPrice * item.Quantity)</td>
                </tr>
            }
        </table>
    </div>
</div>

<p>
    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
</p>
